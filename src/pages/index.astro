---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PostList from '../components/PostList.astro';
import { getSortedPosts } from '../lib/posts';
import { SITE } from '../consts';

const posts = await getSortedPosts();
const pageCount = Math.ceil(posts.length / SITE.postsPerPage);
const pagePosts = posts.slice(0, SITE.postsPerPage);
const page = {
  currentPage: 1,
  lastPage: pageCount,
  url: { next: pageCount > 1 ? '/2/' : undefined },
};
---

<BaseLayout title={`${SITE.title} | ${SITE.author}`}>
  <Container>
    <PostList posts={pagePosts} page={page} />
  </Container>
</BaseLayout>
