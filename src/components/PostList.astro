---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import Summary from './Summary.astro';
import Pagination from './Pagination.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  page: {
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string };
  };
}

const { posts, page } = Astro.props;
---

{posts.map((post) => (
  <Card>
    <Summary
      date={post.data.date}
      title={post.data.title}
      excerpt={post.data.excerpt}
      image={post.data.featuredImage}
      slug={post.slug}
    />
  </Card>
))}
<Pagination
  isFirst={page.currentPage === 1}
  isLast={page.currentPage === page.lastPage}
  previousUrl={page.url.prev}
  nextUrl={page.url.next}
/>
