---
import type { ImageMetadata } from 'astro:assets';
import FeaturedImage from './FeaturedImage.astro';

interface Props {
  date: Date;
  title: string;
  excerpt?: string;
  slug: string;
  image?: ImageMetadata;
}

const { date, title, excerpt, slug, image } = Astro.props;
const formattedDate = date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const href = `/blog/${slug}/`;
---

<div class="summary">
  {image && (
    <a href={href}>
      <FeaturedImage image={image} />
    </a>
  )}
  <h1><a href={href}>{title}</a></h1>
  <span class="date">{formattedDate}</span>
  {excerpt && <p class="excerpt">{excerpt}</p>}
  <a class="continue-reading" href={href}>Continue Reading &rarr;</a>
</div>

<style>
  .summary {
    text-align: center;
  }

  .summary h1 {
    color: #3e465b;
    font-size: 25px;
    line-height: 1.5;
    margin: 0;
    padding: 0 30px;
    text-align: center;
  }

  .summary h1 a {
    color: #3e465b;
    text-decoration: none;
  }

  .summary h1 a:hover {
    color: var(--primary-color);
  }

  .date {
    color: #666d71;
    display: block;
    font-size: 1.6em;
    margin: 0;
    text-align: center;
  }

  .excerpt {
    color: #666d71;
    display: block;
    font-size: 1.6em;
    margin: 50px 0 0 0;
    text-align: center;
  }

  .continue-reading {
    color: #666d71;
    display: inline-block;
    font-size: 14px;
    margin-top: 50px;
    text-decoration: none;
  }

  .continue-reading:hover {
    color: var(--primary-color);
  }
</style>
